PORT=5000
SQLITE_DB_PATH=./data/icart.db
JWT_SECRET=
WEIGHT_TOLERANCE_GRAMS=5
NODE_ENV=development
HARDWARE_WEIGHT_MAX_AGE_MS=5000
REPORT_FAST_UNITS_PER_DAY=1
REPORT_SLOW_UNITS_PER_DAY=0.25
REPORT_MINIMUM_HISTORY_DAYS=14

# QR Ph payment provider. Keep "mock" for local kiosk development. For a
# production acquirer, set its adapter name, HTTPS endpoint and credentials.
QRPH_PROVIDER=mock
QRPH_CREATE_PAYMENT_URL=
QRPH_API_KEY=
QRPH_WEBHOOK_SECRET=
QRPH_WEBHOOK_URL=
# Optional override for phone-accessible mock checkout links. When omitted,
# the backend automatically selects a private LAN IPv4 address.
QRPH_MOCK_CHECKOUT_BASE_URL=

# BP210 direct USB receipt printing on the Raspberry Pi kiosk.
RECEIPT_PRINTER_ENABLED=false
RECEIPT_PRINTER_PYTHON=/usr/bin/python3
RECEIPT_PRINTER_SCRIPT=/home/icart/icart/hardware/bp210_printer.py

# Gmail API over HTTPS (highest priority; works on Railway Trial/Free/Hobby).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Resend API over HTTPS (fallback when Gmail API is not configured).
RESEND_API_KEY=
EMAIL_FROM=iCart <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=10000

# Optional SMTP fallback (Railway Pro or local development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

