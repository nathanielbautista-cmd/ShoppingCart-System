PORT=5000
MONGODB_URI=mongodb://localhost:27017/
JWT_SECRET=
WEIGHT_TOLERANCE_GRAMS=5
NODE_ENV=development
HARDWARE_WEIGHT_MAX_AGE_MS=5000
REPORT_FAST_UNITS_PER_DAY=1
REPORT_SLOW_UNITS_PER_DAY=0.25
REPORT_MINIMUM_HISTORY_DAYS=14

# Recommended for Railway Trial/Free/Hobby because outbound SMTP is blocked.
RESEND_API_KEY=
EMAIL_FROM=iCart <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=10000

# Optional SMTP fallback (Railway Pro or local development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

