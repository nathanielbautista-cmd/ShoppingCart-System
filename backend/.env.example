PORT=5000
SQLITE_DB_PATH=./data/icart.db
JWT_SECRET=
WEIGHT_TOLERANCE_GRAMS=5
NODE_ENV=development
HARDWARE_WEIGHT_MAX_AGE_MS=5000
REPORT_FAST_UNITS_PER_DAY=1
REPORT_SLOW_UNITS_PER_DAY=0.25
REPORT_MINIMUM_HISTORY_DAYS=14

# Gmail API over HTTPS (highest priority; works on Railway Trial/Free/Hobby).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Resend API over HTTPS (fallback when Gmail API is not configured).
RESEND_API_KEY=
EMAIL_FROM=iCart <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=10000

# Optional SMTP fallback (Railway Pro or local development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

