PORT=5000
SQLITE_DB_PATH=./data/icart.db
JWT_SECRET=
WEIGHT_TOLERANCE_GRAMS=5
NODE_ENV=development
HARDWARE_WEIGHT_MAX_AGE_MS=5000
REPORT_FAST_UNITS_PER_DAY=1
REPORT_SLOW_UNITS_PER_DAY=0.25
REPORT_MINIMUM_HISTORY_DAYS=14

# QR Ph payment provider. Keep "mock" for local kiosk development. For a
# production acquirer, set its adapter name, HTTPS endpoint and credentials.
QRPH_PROVIDER=mock
QRPH_CREATE_PAYMENT_URL=
QRPH_API_KEY=
QRPH_WEBHOOK_SECRET=
QRPH_WEBHOOK_URL=
# Optional override for phone-accessible mock checkout links. When omitted,
# the backend automatically selects a private LAN IPv4 address.
QRPH_MOCK_CHECKOUT_BASE_URL=

# BP210 direct USB receipt printing on the Raspberry Pi kiosk.
RECEIPT_PRINTER_ENABLED=false
RECEIPT_PRINTER_PYTHON=/usr/bin/python3
RECEIPT_PRINTER_SCRIPT=/home/icart/icart/hardware/bp210_printer.py
# Use `bluetooth` with the paired printer address, or leave `usb` for a cable.
RECEIPT_PRINTER_TRANSPORT=usb
RECEIPT_PRINTER_BLUETOOTH_ADDRESS=
RECEIPT_PRINTER_BLUETOOTH_CHANNEL=1

# Kiosk speaker. `auto` prefers a natural Piper neural model and falls back to
# offline eSpeak. Put the model at the path below to enable the natural voice.
ICART_TTS_PROVIDER=dfplayer
ICART_PIPER_EXECUTABLE=/usr/local/bin/piper
ICART_PIPER_MODEL=/home/icart/icart/voice/en_US-lessac-medium.onnx
ICART_AUDIO_DEVICE=plughw:CARD=Headphones,DEV=0
ICART_ESPEAK_EXECUTABLE=/usr/bin/espeak-ng
ICART_ESPEAK_VOICE=en-us+m3
ICART_TTS_RATE=150
ICART_TTS_VOLUME=180

# DFPlayer Mini UART speaker. Enable this on the Raspberry Pi after enabling
# /dev/serial0 and placing numbered MP3s in /mp3 on its microSD card.
# With MP3 mode, track 1 is /mp3/0001.mp3. Track values left blank are skipped.
ICART_DFPLAYER_ENABLED=true
ICART_DFPLAYER_DEVICE=/dev/serial0
ICART_DFPLAYER_MODE=mp3
ICART_DFPLAYER_VOLUME=18
ICART_DFPLAYER_SCRIPT=/home/icart/icart/hardware/dfplayer_player.py
ICART_DFPLAYER_TRACK_DEFAULT=2
ICART_DFPLAYER_TRACK_WELCOME=2
ICART_DFPLAYER_TRACK_BUDGET=3
ICART_DFPLAYER_TRACK_SCANNED=4
ICART_DFPLAYER_TRACK_ITEM_ADDED=5
ICART_DFPLAYER_TRACK_WEIGHT_VERIFICATION_FAILED=6
ICART_DFPLAYER_TRACK_UNSCANNED=7
ICART_DFPLAYER_TRACK_ALARM=8
ICART_DFPLAYER_TRACK_ALARM_TONE=25
ICART_DFPLAYER_TRACK_ALARM_INSTRUCTION=26
ICART_DFPLAYER_TRACK_REMOVE_ITEM=9
ICART_DFPLAYER_TRACK_ITEM_REMOVED=10
ICART_DFPLAYER_TRACK_PAYMENT_READY=11
ICART_DFPLAYER_TRACK_PAYMENT_SUCCESS=12
ICART_DFPLAYER_TRACK_BUDGET_WARNING=13
ICART_DFPLAYER_TRACK_BUDGET_EXCEEDED=14
ICART_DFPLAYER_TRACK_BUDGET_ERROR=15
ICART_DFPLAYER_TRACK_SCAN_ERROR=16
ICART_DFPLAYER_TRACK_SESSION_ERROR=17
ICART_DFPLAYER_TRACK_REMOVE_ERROR=18
ICART_DFPLAYER_TRACK_WEIGHT_CHANGE_NOT_DETECTED=19
ICART_DFPLAYER_TRACK_PAYMENT_CANCELLED=20
ICART_DFPLAYER_TRACK_BUDGET_REACHED=21
ICART_DFPLAYER_TRACK_PAYMENT_FAILED=22
ICART_DFPLAYER_TRACK_SCAN_CANCELLED=23
ICART_DFPLAYER_TRACK_CART_ERROR=24

# Native Windows kiosk voice. `auto` selects SAPI automatically on Windows.
# Optionally use part of an installed voice name, such as Zira or David.
ICART_SAPI_VOICE=Microsoft David Desktop
ICART_SAPI_OUTPUT=Speakers
ICART_SAPI_RATE=0
ICART_SAPI_VOLUME=100

# Gmail API over HTTPS (highest priority; works on Railway Trial/Free/Hobby).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=

# Resend API over HTTPS (fallback when Gmail API is not configured).
RESEND_API_KEY=
EMAIL_FROM=iCart <onboarding@resend.dev>
EMAIL_TIMEOUT_MS=10000

# Optional SMTP fallback (Railway Pro or local development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

