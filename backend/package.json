{
  "name": "icart-backend",
  "version": "1.0.0",
  "description": "iCart Smart Shopping Cart Backend API with embedded SQLite, barcode scanning, and weight verification",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
