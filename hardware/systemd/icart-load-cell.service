[Unit]
Description=iCart HX711 Load-Cell Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=icart
Group=icart
SupplementaryGroups=gpio
WorkingDirectory=/home/icart/icart/hardware
Environment=ICART_API_URL=http://127.0.0.1:5000
Environment=ICART_DEVICE_ID=cart-pi-01
EnvironmentFile=-/etc/default/icart-load-cell
ExecStart=/usr/bin/python3 /home/icart/icart/hardware/load_cell_service.py --interval 0.10
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
